meters\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"read_lines\",\"description\":\"Read an exact inclusive line range from one current candidate file. If the requested content exceeds 12,000 bytes, returns the largest exact line prefix that fits plus a version-bound continuation_cursor; it does not automatically fetch the next page. A single line larger than the limit is rejected explicitly.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"end_line\":{\"minimum\":1,\"type\":\"integer\"},\"path\":{\"minLength\":1,\"type\":\"string\"},\"start_line\":{\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"path\",\"start_line\",\"end_line\"],\"type\":\"object\"}},{\"action\":\"read_region\",\"description\":\"Read one exact mechanically defined target region by the stable ID exposed in the initial outline. The operation is available only while the target still matches the outline's file hash. It supplies exact bytes, not a summary or relevance judgment.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"region_id\":{\"pattern\":\"^R[0-9]{3}$\",\"type\":\"string\"}},\"required\":[\"region_id\"],\"type\":\"object\"}},{\"action\":\"patch\",\"description\":\"Replace one exact UTF-8 string in one candidate file. The old text must occur exactly once and expected_file_sha256 must equal the hash returned by a current read.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"expected_file_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"new\":{\"type\":\"string\"},\"old\":{\"minLength\":1,\"type\":\"string\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\",\"old\",\"new\",\"expected_file_sha256\"],\"type\":\"object\"}},{\"action\":\"replace_file\",\"description\":\"Replace one complete UTF-8 candidate file. expected_file_sha256 must equal the hash returned by a current read. new_content becomes the complete file; the resulting file must remain within the fixture's patched-file byte limit.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"expected_file_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"new_content\":{\"type\":\"string\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\",\"expected_file_sha256\",\"new_content\"],\"type\":\"object\"}},{\"action\":\"repo_list\",\"description\":\"Enumerate immediate tracked children of one exact repository directory at the pinned source commit, including saved run directories excluded from catalog and search. Returns deterministic paths, Git object identities, kinds, sizes, and a bounded page of at most 50 entries. Use path '.' for the root. If next_cursor is not null, call the same path with that cursor for the next page. This is mechanical address discovery, not semantic selection.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"cursor\":{\"minimum\":0,\"type\":\"integer\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"repo_catalog\",\"description\":\"Find eligible tracked repository file paths at the pinned source commit by a literal, case-insensitive path substring. Saved run trees, content-addressed artifacts, and other disclosed excluded path classes are not indexed here. Returns exact blob identities and sizes, not file content or semantic ranking. At most 50 records are returned. Use repo_list when a directory identity is already known or may be excluded.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"query\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}},{\"action\":\"repo_read_lines\",\"description\":\"Read an exact inclusive line range from one tracked repository blob. If the requested content exceeds 12,000 bytes, returns the largest exact line prefix that fits plus a version-bound continuation_cursor;