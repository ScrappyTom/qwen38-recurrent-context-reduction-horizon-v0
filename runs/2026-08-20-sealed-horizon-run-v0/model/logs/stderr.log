ant\n<think>\n\n</think>\n\n","samplers":["penalties","dry","top_n_sigma","top_k","typ_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":-1,"n_decoded":0}],"prompt":"<|im_start|>system\nYou are operating a bounded local artifact workbench. Return exactly one bare JSON action per assistant turn matching the supplied response schema, with no Markdown or extra text. The response schema and action catalog are authoritative; undeclared fields and invalid actions are rejected without repair. Action parameter fields are at the same top level as the action field. Patch replaces one exact string and transmits both old and new text. Replace_file replaces one complete UTF-8 file and transmits only the new content. Both mutation actions require the current file hash returned by read. Check runs only a declared visible check. Submit binds the exact current candidate and ends the run. The run permits at most 24 model calls. Action catalog: [{\"action\":\"tree\",\"description\":\"List candidate files and directories under one relative path.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"search\",\"description\":\"Find literal text in UTF-8 candidate files under one relative path. Returns mechanically bounded exact match windows with line and character coordinates; use read_lines for more context.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"minLength\":1,\"type\":\"string\"},\"query\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"query\",\"path\"],\"type\":\"object\"}},{\"action\":\"read\",\"description\":\"Read one complete UTF-8 candidate file with its candidate and file hashes. Files over 12,000 bytes are rejected; use read_lines.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"read_lines\",\"description\":\"Read an exact inclusive line range from one current candidate file. If the requested content exceeds 12,000 bytes, returns the largest exact line prefix that fits plus a version-bound continuation_cursor; it does not automatically fetch the next page. A single line larger than the limit is rejected explicitly.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"end_line\":{\"minimum\":1,\"type\":\"integer\"},\"path\":{\"minLength\":1,\"type\":\"string\"},\"start_line\":{\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"path\",\"start_line\",\"end_line\"],\"type\":\"object\"}},{\"action\":\"read_region\",\"description\":\"Read one exact mechanically defined target region by the stable ID exposed in the initial outline. The operation is available only while the target still matches the outline's file hash. It supplies exact bytes, not a summary or relevance judgment.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"region_id\":{\"pattern\":\"^R[0-9]{3}$\",\"type\":\"string\"}},\"required\":[\"region_id\"],\"type\":\"object\"}},{\"action\":\"patch\",\"description\":\"Replace one exact UTF-8 string in one candidate file. The old text must occur exactly once and expected_file_sha256 must equal the hash returned by a current read.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"expected_file_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"new\":{\"type\":\"string\"},\"old\":{\"minLength\":1,\"type\":\"string\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\",\"old\",\"new\",\"expected_file_sha256\"],\"type\":\"object\"}},{\"action\":\"replace_file\",\"description\":\"Replace one complete UTF-8 candidate file. expected_file_sha256 must equal the hash returned by a current read. new_content becomes the complete file; the resulting file must remain within the fixture's patched-file byte limit.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"expected_file_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"new_content\":{\"type\":\"string\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\",\"expected_file_sha256\",\"new_content\"],\"type\":\"object\"}},{\"action\":\"repo_list\",\"description\":\"Enumerate immediate tracked children of one exact repository directory at the pinned source commit, including saved run directories excluded from catalog and search. Returns deterministic paths, Git object identities, kinds, sizes, and a bounded page of at most 50 entries. Use path '.' for the root. If next_cursor is not null, call the same path with that cursor for the next page. This is mechanical address discovery, not semantic selection.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"cursor\":{\"minimum\":0,\"type\":\"integer\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"repo_catalog\",\"description\":\"Find eligible tracked repository file paths at the pinned source commit by a literal, case-insensitive path substring. Saved run trees, content-addressed artifacts, and other disclosed excluded path classes are not indexed here. Returns exact blob identities and sizes, not file content or semantic ranking. At most 50 records are returned. Use repo_list when a directory identity is already known or may be excluded.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"query\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}},{\"action\":\"repo_read_lines\",\"description\":\"Read an exact inclusive line range from one tracked repository blob. If the requested content exceeds 12,000 bytes, returns the largest exact line prefix that fits plus a version-bound continuation_cursor; it does not automatically fetch the next page. A single line larger than the limit is rejected explicitly.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"end_line\":{\"minimum\":1,\"type\":\"integer\"},\"path\":{\"minLength\":1,\"type\":\"string\"},\"start_line\":{\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"path\",\"start_line\",\"end_line\"],\"type\":\"object\"}},{\"action\":\"continue_lines\",\"description\":\"Continue one previously truncated read_lines or repo_read_lines request from its exact next line. The version-bound cursor is tied to path, requested end, transfer limit, and candidate/file or commit/blob version. Stale or altered cursors are rejected. Calling this remains model-directed; no page is fetched automatically.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"cursor\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"cursor\"],\"type\":\"object\"}},{\"action\":\"repo_search\",\"description\":\"Find literal text in tracked UTF-8 project sources at the pinned commit. Saved run trees and content-addressed artifacts are excluded from this search index. Returns mechanically bounded exact match windows with path, line, and character coordinates; use repo_read_lines for more context.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"path_prefix\":{\"minLength\":1,\"type\":\"string\"},\"query\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"query\",\"path_prefix\"],\"type\":\"object\"}},{\"action\":\"repo_read\",\"description\":\"Read one exact tracked UTF-8 repository blob at the pinned source commit. Returns its path, commit, blob SHA, size, and complete content. Files over 12,000 bytes are rejected; use repo_read_lines.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"repo_history\",\"description\":\"Return up to ten exact Git commit records touching one 